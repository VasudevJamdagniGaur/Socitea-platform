# Public, non-secret product configuration only.
# Copy to .env.local for local overrides. Never commit real secrets.

# Canonical website origin (no trailing slash). Used for SEO canonical/OG URLs.
VITE_WEBSITE_URL=

# Support / contact
VITE_SUPPORT_EMAIL=hello@socitea.app
VITE_COMPANY_NAME=SociTea

# Android — set only verified official URLs
VITE_ANDROID_PLAY_STORE_URL=
VITE_ANDROID_APK_URL=
VITE_ANDROID_VERSION=

# Chrome extension — set only a verified Chrome Web Store URL
VITE_CHROME_WEB_STORE_URL=
VITE_EXTENSION_VERSION=

# Deployed SociTea web application (not this marketing site)
VITE_WEB_APP_URL=
VITE_WEB_APP_VERSION=

# Optional external legal pages (otherwise use on-site /privacy and /terms)
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# Optional social profiles — omit or leave empty to hide footer links
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_INSTAGRAM=
